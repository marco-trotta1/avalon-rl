{
  "name": "avalon-rl",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Local command-line appraisal of RL environments and data traces.",
  "bin": { "avalon-rl": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "analyze": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:engine": "vitest run tests/engine.test.ts",
    "test:cli": "npm run build && vitest run tests/cli.test.ts",
    "check:privacy": "node scripts/check-privacy.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": { "node": ">=22.12.0" }
}
